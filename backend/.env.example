# Postgres connection, read by `app/config.py` (DatabaseSettings) via piccolo_conf.py.
# Defaults already match the Docker `db` service, so copying this file is only
# needed if you run Postgres elsewhere or change the credentials.
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=ledger
PG_USER=ledger
PG_PASSWORD=ledger

# The test suite selects piccolo_conf_test (PICCOLO_CONF, set by `just backend-test`),
# which runs against a separate database — `ledger_test` by default. Override its
# name here if needed:
# PG_TEST_DATABASE=ledger_test
