# Backend base URL(s) used by the generated API client
# (src/features/common/api/client.ts). Never hard-coded in components.
#
# VITE_API_BASE_URL: used by the browser (Vite inlines VITE_-prefixed vars
# into the client bundle), so it must be a host-reachable URL.
# Host-side dev: the backend also runs on the host, so localhost works.
VITE_API_BASE_URL=http://localhost:8000

# API_SERVER_BASE_URL: used only by the SSR loader running in this process.
# Deliberately NOT VITE_-prefixed, so Vite never inlines it into the browser
# bundle. Containerized dev (docker-compose) sets this to http://backend:8000
# (the compose network's service name) since the frontend container can reach
# the backend container there, but the host browser cannot.
# API_SERVER_BASE_URL=http://backend:8000
